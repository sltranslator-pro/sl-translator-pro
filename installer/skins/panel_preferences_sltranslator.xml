<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
 border="true"
 follows="all"
 height="480"
 layout="topleft"
 left="1"
 top="1"
 width="540"
 label="SL Translator"
 name="sltranslator">

    <text
     follows="left|top"
     height="25"
     layout="topleft"
     left="20"
     top="20"
     width="400"
     font="SansSerifLargeBold"
     name="slt_title">
     SL Translator Pro
    </text>

    <text
     follows="left|top"
     height="40"
     layout="topleft"
     left="20"
     top_pad="15"
     width="450"
     wrap="true"
     name="slt_desc">
     Real-time chat translation for Second Life. Configure your license key, language settings, and translation preferences.
    </text>

    <button
     follows="left|top"
     height="30"
     layout="topleft"
     left="20"
     top_pad="20"
     name="slt_open_settings"
     width="250"
     font="SansSerifBold"
     commit_callback.function="Floater.ToggleOrBringToFront"
     commit_callback.parameter="prefs_translation"
     label="Open SL Translator Settings" />

    <text
     follows="left|top"
     height="100"
     layout="topleft"
     left="20"
     top_pad="25"
     width="450"
     wrap="true"
     name="slt_help">
     Quick Commands (type in local chat):
       /tr off - Disable outgoing translation
       /tr on - Enable outgoing translation
       /tr src on - Also show your original text (space permitting)
       /tr src off - Hide original text again
       /tr debug - Toggle debug logging
       /tr status - Show current status
    </text>

    <text
     follows="left|bottom"
     height="20"
     layout="topleft"
     left="20"
     bottom="-10"
     width="400"
     name="slt_footer">
     sltranslate.com | info@sltranslate.com
    </text>

</panel>
