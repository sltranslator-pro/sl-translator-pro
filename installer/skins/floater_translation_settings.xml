 <!-- Hidden radio group (Azure always selected) -->
 <radio_group follows="top|left" height="1" layout="topleft" left_delta="10" name="translation_service_rg" top_pad="0" width="1" visible="false">
  <radio_item initial_value="azure" label="" layout="topleft" name="azure" />
  <radio_item initial_value="google" label="" layout="topleft" name="google" top_pad="0" />
  <radio_item initial_value="deepl" label="" layout="topleft" name="deepl" top_pad="0" />
 </radio_group>

 <text type="string" length="1" follows="top|right" height="1" layout="topleft" left="185" name="azure_links_text" top_pad="0" width="1" visible="false"></text>

