<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 legacy_header_height="18"
 height="280"
 layout="topleft"
 name="floater_translation_settings"
 help_topic="translation_settings"
 save_rect="false"
 can_resize="false"
 title="SL Translator Pro"
 width="420">

 <string name="azure_api_key_not_verified">License key not verified. Status: [STATUS]. Please check your key and try again.</string>
