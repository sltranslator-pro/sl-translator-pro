 <!-- License Key -->
 <text
  type="string"
  length="1"
  follows="top|right"
  height="20"
  layout="topleft"
  left="20"
  name="azure_api_key_label"
  top_pad="10"
  width="120">
  License Key:
 </text>
 <line_editor
  default_text="Enter your license key and click Verify"
  follows="top|left"
  height="20"
  layout="topleft"
  left_pad="10"
  max_length_chars="50"
  top_delta="-4"
  name="azure_api_key"
  width="150" />
 <text type="string" length="1" follows="top|right" height="1" layout="topleft" left="70" name="azure_api_region_label" top_pad="0" width="1" visible="false">Region:</text>
 <line_editor default_text="global" follows="top|left" height="1" layout="topleft" left_pad="0" max_length_chars="50" top_delta="0" name="azure_api_region" width="1" visible="false" />
 <button
  follows="left|top"
  height="23"
  label="Verify"
  layout="topleft"
  left_pad="10"
  name="verify_azure_api_key_btn"
  top_delta="-2"
  width="70" />

 <!-- Hidden Google/DeepL fields (required by C++) -->
 <text follows="top|right" height="1" layout="topleft" left="70" length="1" name="google_api_key_label" top_pad="0" type="string" width="1" visible="false"></text>
 <line_editor follows="top|left" height="1" layout="topleft" left_pad="0" max_length_chars="50" top_delta="0" name="google_api_key" width="1" visible="false" />
 <button follows="left|top" height="1" layout="topleft" left_pad="0" name="verify_google_api_key_btn" top_delta="0" width="1" visible="false" />
 <text follows="top|right" height="1" layout="topleft" left="185" length="1" name="google_links_text" top_delta="0" type="string" width="1" visible="false"></text>
 <text type="string" length="1" follows="top|right" height="1" layout="topleft" left="70" name="deepl_api_domain_label" top_pad="0" width="1" visible="false"></text>
 <combo_box allow_text_entry="false" follows="left|top" name="deepl_api_domain_combo" height="1" left_pad="0" width="1" top_delta="0" max_chars="512" value="https://api-free.deepl.com" visible="false">
     <combo_box.item label="DeepL Free" name="global" value="https://api-free.deepl.com" />
 </combo_box>
 <text follows="top|right" height="1" layout="topleft" left="70" length="1" name="deepl_api_key_label" top_pad="0" type="string" width="1" visible="false"></text>
 <line_editor follows="top|left" height="1" layout="topleft" left_pad="0" max_length_chars="50" top_delta="0" name="deepl_api_key" width="1" visible="false" />
 <button follows="left|top" height="1" layout="topleft" left_pad="0" name="verify_deepl_api_key_btn" top_delta="0" width="1" visible="false" />
 <text follows="top|right" height="1" layout="topleft" left="185" length="1" name="deepl_links_text" top_delta="0" type="string" width="1" visible="false"></text>

 <!-- Buttons -->
 <button
  follows="left|top"
  height="23"
  label="Save &amp; Apply"
  layout="topleft"
  right="-120"
  name="ok_btn"
  top="-30"
  width="110"
  commit_callback.function="Floater.ToggleOrBringToFront"
  commit_callback.parameter="preferences" />
 <button
  follows="left|top"
  height="23"
  label="Cancel"
  layout="topleft"
  left_pad="5"
  name="cancel_btn"
  width="100" />
</floater>
