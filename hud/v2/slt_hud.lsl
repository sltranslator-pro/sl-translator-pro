// SL Translator Pro - HUD v2
//
// Build once (details in HUD_SETUP.md):
//   1. Rez a box. Put slt_hud_panel, slt_hud_langs and this script in it.
//   2. Rez 3 more small boxes, select them, then select the main box LAST
//      and link (Ctrl+L). The script names and places them itself:
//      two language windows and the drop-down language list.
//   3. Touch the panel once on the side you want to see.
//   4. Attach to HUD (Bottom or Top).
//
// Talks to the DLL with llOwnerSay("/tr ..."). Licence state comes from
// https://api.sltranslate.com/api/hud/status, matched by the wearer's avatar
// UUID that Second Life sends with every request (no licence key in the HUD).

// ------------------------------------------------------------ constants
string TEX_PANEL = "slt_hud_panel";
string TEX_LANGS = "slt_hud_langs";
string STATUS_URL = "https://api.sltranslate.com/api/hud/status";

// 32 languages, same order as the slt_hud_langs atlas (4 columns x 8 rows).
list CODES = ["ar","bg","zh","hr","cs","da","nl","en",
              "fi","fr","de","el","he","hi","hu","id",
              "it","ja","ko","ms","no","fa","pl","pt",
              "ro","ru","es","sv","th","tr","uk","vi"];
list NAMES = ["Arabic","Bulgarian","Chinese","Croatian","Czech","Danish","Dutch","English",
              "Finnish","French","German","Greek","Hebrew","Hindi","Hungarian","Indonesian",
              "Italian","Japanese","Korean","Malay","Norwegian","Persian","Polish","Portuguese",
              "Romanian","Russian","Spanish","Swedish","Thai","Turkish","Ukrainian","Vietnamese"];

// Touch map on the main face, s ranges (0..1, left to right).
// Generated by make_hud_v2.py; keep both in sync.
list ZONES = ["power", 0.0137, 0.1465,
              "my",    0.1582, 0.4297,
              "swap",  0.4395, 0.4941,
              "send",  0.5039, 0.7754,
              "dual",  0.7871, 0.8848,
              "status",0.8945, 0.9863];

// Language windows on the bar (texture coordinates of the window centres).
float WIN_MY_S   = 0.2676;
float WIN_SEND_S = 0.6133;
float WIN_T      = 0.5312;
float WIN_W      = 0.1953; // fraction of bar width
float WIN_H      = 0.3906; // fraction of bar height

// Bar size in metres when attached (the front face).
vector BAR_SIZE = <0.01, 0.40, 0.10>;
float  PICK_GAP = 0.006;   // gap between bar and picker

// ------------------------------------------------------------ state
integer gOn = TRUE;
integer gDual = FALSE;
string  gMy = "";      // "" = follow Firestorm settings
string  gSend = "";
string  gPicking = ""; // "", "my" or "send"

integer FACE = -1;     // visible face: 2 (+X) or 4 (-X), set by the first touch
integer FLIP = FALSE;  // set TRUE if the language windows land on the wrong labels
integer gLinkMy;
integer gLinkSend;
integer gLinkPick;
key     gReq;
float   gLastStatus;
integer gQuiet;        // status request made silently on attach

// ------------------------------------------------------------ helpers
Send(string cmd) { llOwnerSay(cmd); }

Note(string msg) { llOwnerSay("SL Translator: " + msg); }

string LangName(string code)
{
    integer i = llListFindList(CODES, [code]);
    if (i == -1) return "Firestorm setting";
    return llList2String(NAMES, i);
}

Save()
{
    llLinksetDataWrite("on", (string)gOn);
    llLinksetDataWrite("dual", (string)gDual);
    llLinksetDataWrite("my", gMy);
    llLinksetDataWrite("send", gSend);
    llLinksetDataWrite("face", (string)FACE);
}

Load()
{
    if (llLinksetDataRead("on") == "") return;
    gOn = (integer)llLinksetDataRead("on");
    gDual = (integer)llLinksetDataRead("dual");
    gMy = llLinksetDataRead("my");
    gSend = llLinksetDataRead("send");
    string f = llLinksetDataRead("face");
    if (f != "") FACE = (integer)f;
}

FindLinks()
{
    gLinkMy = 0; gLinkSend = 0; gLinkPick = 0;
    integer n = llGetNumberOfPrims();
    integer i;
    for (i = 2; i <= n; ++i)
    {
        string nm = llGetLinkName(i);
        if (nm == "slt_my") gLinkMy = i;
        else if (nm == "slt_send") gLinkSend = i;
        else if (nm == "slt_pick") gLinkPick = i;
    }
}

// Show one atlas cell (index 0..31) on a child prim face, or "unset".
ShowCell(integer link, integer idx)
{
    if (!link) return;
    if (idx < 0)
    {
        llSetLinkPrimitiveParamsFast(link, [PRIM_COLOR, ALL_SIDES, <1,1,1>, 0.0]);
        return;
    }
    integer col = idx % 4;
    integer row = idx / 4;
    // Atlas cell is 1/4 wide, 1/8 tall. Offsets are relative to the centre.
    float u = (col * 0.25 + 0.125) - 0.5;
    float v = 0.5 - (row * 0.125 + 0.0625);
    llSetLinkPrimitiveParamsFast(link, [
        PRIM_COLOR, ALL_SIDES, <1,1,1>, 0.0,
        PRIM_TEXTURE, FACE, TEX_LANGS, <0.25, 0.125, 0.0>, <u, v, 0.0>, 0.0,
        PRIM_COLOR, FACE, <1,1,1>, 1.0,
        PRIM_FULLBRIGHT, FACE, TRUE
    ]);
}

// Main bar shows one of four stacked state images (1024x256 each).
ShowBar()
{
    integer row = 0;
    if (!gOn) row = 2;
    if (gDual) row += 1;
    float v = 0.375 - row * 0.25;
    llSetLinkPrimitiveParamsFast(LINK_THIS, [
        PRIM_TEXTURE, FACE, TEX_PANEL, <1.0, 0.25, 0.0>, <0.0, v, 0.0>, 0.0,
        PRIM_FULLBRIGHT, FACE, TRUE
    ]);
    ShowCell(gLinkMy, llListFindList(CODES, [gMy]));
    ShowCell(gLinkSend, llListFindList(CODES, [gSend]));
}

// Horizontal position (local Y) of a point at texture s on the visible face.
// Viewed from +X (face 2) s grows toward +Y, viewed from -X (face 4) toward -Y.
float SToY(float s)
{
    float y = (s - 0.5) * BAR_SIZE.y;
    if (FACE == 4) y = -y;
    if (FLIP) y = -y;
    return y;
}

// Lay the two window prims over the bar and park the picker below it.
// Windows are thicker than the bar so they show on whichever side faces you.
Layout()
{
    llSetLinkPrimitiveParamsFast(LINK_THIS, [PRIM_SIZE, BAR_SIZE]);
    vector win = <BAR_SIZE.x * 2.0, BAR_SIZE.y * WIN_W, BAR_SIZE.z * WIN_H>;
    float z = (WIN_T - 0.5) * BAR_SIZE.z;
    if (gLinkMy)
        llSetLinkPrimitiveParamsFast(gLinkMy, [
            PRIM_SIZE, win, PRIM_POS_LOCAL, <0.0, SToY(WIN_MY_S), z>,
            PRIM_ROT_LOCAL, ZERO_ROTATION]);
    if (gLinkSend)
        llSetLinkPrimitiveParamsFast(gLinkSend, [
            PRIM_SIZE, win, PRIM_POS_LOCAL, <0.0, SToY(WIN_SEND_S), z>,
            PRIM_ROT_LOCAL, ZERO_ROTATION]);
    ClosePicker();
}

// The list opens below the bar, or above it when the HUD sits at the bottom
// of the screen so it never drops off screen.
OpenPicker(string which)
{
    if (!gLinkPick) { Note("language list prim (slt_pick) is missing."); return; }
    gPicking = which;
    float side = BAR_SIZE.y * 0.8;
    float dz = -(BAR_SIZE.z * 0.5 + PICK_GAP + side * 0.5);
    integer a = llGetAttached();
    if (a == ATTACH_HUD_BOTTOM || a == ATTACH_HUD_BOTTOM_LEFT || a == ATTACH_HUD_BOTTOM_RIGHT)
        dz = -dz;
    llSetLinkPrimitiveParamsFast(gLinkPick, [
        PRIM_SIZE, <0.01, side, side>,
        PRIM_POS_LOCAL, <0.0, 0.0, dz>,
        PRIM_ROT_LOCAL, ZERO_ROTATION,
        PRIM_COLOR, ALL_SIDES, <0.03, 0.05, 0.09>, 1.0,
        PRIM_TEXTURE, FACE, TEX_LANGS, <1,1,0>, <0,0,0>, 0.0,
        PRIM_COLOR, FACE, <1,1,1>, 1.0,
        PRIM_FULLBRIGHT, FACE, TRUE
    ]);
    if (which == "my") Note("choose the language you READ.");
    else Note("choose the language you SEND.");
}

ClosePicker()
{
    gPicking = "";
    if (!gLinkPick) return;
    // Parked tiny and invisible just under the bar, never inside it, so it
    // cannot steal touches from the buttons.
    llSetLinkPrimitiveParamsFast(gLinkPick, [
        PRIM_SIZE, <0.01, 0.01, 0.01>,
        PRIM_POS_LOCAL, <0.0, 0.0, -(BAR_SIZE.z * 0.5 + 0.02)>,
        PRIM_COLOR, ALL_SIDES, <1,1,1>, 0.0
    ]);
}

ApplyLanguages()
{
    if (gMy == "" || gSend == "")
    {
        Send("/tr lang auto");
        return;
    }
    Send("/tr lang " + gMy + " " + gSend);
}

ApplyAll()
{
    if (gOn) Send("/tr on"); else Send("/tr off");
    if (gDual) Send("/tr src on"); else Send("/tr src off");
    ApplyLanguages();
}

string ZoneAt(float s)
{
    integer i;
    integer n = llGetListLength(ZONES);
    for (i = 0; i < n; i += 3)
    {
        if (s >= llList2Float(ZONES, i + 1) && s <= llList2Float(ZONES, i + 2))
            return llList2String(ZONES, i);
    }
    return "";
}

PickLanguage(vector st)
{
    integer col = (integer)(st.x * 4.0);
    integer row = (integer)((1.0 - st.y) * 8.0);
    if (col < 0 || col > 3 || row < 0 || row > 7) return;
    string code = llList2String(CODES, row * 4 + col);
    string other = gSend;
    if (gPicking == "send") other = gMy;
    if (code == other)
    {
        Note("my language and send language must be different.");
        return;
    }
    if (gPicking == "my") gMy = code; else gSend = code;
    ClosePicker();
    if (gMy != "" && gSend != "")
        Note("reading " + LangName(gMy) + ", sending " + LangName(gSend) + ".");
    ApplyLanguages();
    Save();
    ShowBar();
}

Status(integer quiet)
{
    if (!quiet && llGetTime() - gLastStatus < 5.0 && gLastStatus > 0.0) return;
    gLastStatus = llGetTime();
    gQuiet = quiet;
    if (!quiet) Note("checking license...");
    gReq = llHTTPRequest(STATUS_URL, [HTTP_METHOD, "GET", HTTP_MIMETYPE, "application/json"], "");
}

// The visible face is whichever big face (2 or 4) of the bar is touched.
// Touching the other side later simply switches to it.
integer CheckFace(integer link, integer touched)
{
    if (link > 1) return TRUE;
    if (touched != 2 && touched != 4) return TRUE;
    if (touched == FACE) return TRUE;
    FACE = touched;
    Save();
    llSetLinkPrimitiveParamsFast(LINK_THIS, [PRIM_COLOR, ALL_SIDES, <0.05, 0.08, 0.14>, 1.0]);
    Layout();
    ShowBar();
    Note("panel ready.");
    return FALSE;
}

Setup()
{
    FindLinks();
    integer n = llGetNumberOfPrims();
    if (n >= 4 && (!gLinkMy || !gLinkSend || !gLinkPick))
    {
        // Name unnamed children in link order: my, send, pick.
        llSetLinkPrimitiveParamsFast(2, [PRIM_NAME, "slt_my"]);
        llSetLinkPrimitiveParamsFast(3, [PRIM_NAME, "slt_send"]);
        llSetLinkPrimitiveParamsFast(4, [PRIM_NAME, "slt_pick"]);
        FindLinks();
    }
    if (!gLinkMy || !gLinkSend || !gLinkPick)
        Note("link 3 small boxes to this one (they become the two language windows and the language list), then reset the script.");
    if (FACE != -1) { Layout(); ShowBar(); }
    else
    {
        // Not calibrated yet: show the panel on both big faces.
        llSetLinkPrimitiveParamsFast(LINK_THIS, [
            PRIM_SIZE, BAR_SIZE,
            PRIM_TEXTURE, 2, TEX_PANEL, <1.0, 0.25, 0.0>, <0.0, 0.375, 0.0>, 0.0,
            PRIM_TEXTURE, 4, TEX_PANEL, <1.0, 0.25, 0.0>, <0.0, 0.375, 0.0>, 0.0]);
        Note("touch the panel once on the side you want to see.");
    }
}

// ------------------------------------------------------------ events
default
{
    state_entry()
    {
        Load();
        Setup();
    }

    on_rez(integer p) { FindLinks(); }

    attach(key id)
    {
        if (id == NULL_KEY) return;
        FindLinks();
        ClosePicker();
        llSleep(3.0); // give the DLL time to start listening
        ApplyAll();
        ShowBar();
        // Fill empty language windows from what the viewer last reported.
        if (gMy == "" || gSend == "") Status(TRUE);
    }

    changed(integer c)
    {
        if (c & CHANGED_OWNER) { llLinksetDataReset(); llResetScript(); }
        if (c & CHANGED_LINK) Setup();
    }

    touch_start(integer n)
    {
        if (llDetectedKey(0) != llGetOwner()) return;
        integer link = llDetectedLinkNumber(0);
        integer face = llDetectedTouchFace(0);
        vector st = llDetectedTouchST(0);
        if (!CheckFace(link, face)) return;
        if (face != FACE || st.x < 0.0) return;

        if (link == gLinkPick && gPicking != "") { PickLanguage(st); return; }
        if (link == gLinkMy)   { if (gPicking == "my") ClosePicker(); else OpenPicker("my"); return; }
        if (link == gLinkSend) { if (gPicking == "send") ClosePicker(); else OpenPicker("send"); return; }
        if (link > 1) return; // 0 = unlinked prim, 1 = root

        // Only the horizontal position decides the button.
        string z = ZoneAt(st.x);
        if (z == "power")
        {
            gOn = !gOn;
            if (gOn) Send("/tr on"); else Send("/tr off");
            if (gOn) Note("translation ON."); else Note("translation OFF.");
        }
        else if (z == "dual")
        {
            gDual = !gDual;
            if (gDual) Send("/tr src on"); else Send("/tr src off");
            if (gDual) Note("DUAL on: your messages are sent as original + translation.");
            else Note("DUAL off: only the translation is sent.");
        }
        else if (z == "swap")
        {
            if (gMy == "" || gSend == "") { Note("pick both languages first."); return; }
            string t = gMy; gMy = gSend; gSend = t;
            ApplyLanguages();
            Note("reading " + LangName(gMy) + ", sending " + LangName(gSend) + ".");
        }
        else if (z == "my")   { if (gPicking == "my") ClosePicker(); else OpenPicker("my"); return; }
        else if (z == "send") { if (gPicking == "send") ClosePicker(); else OpenPicker("send"); return; }
        else if (z == "status") { Status(FALSE); return; }
        else return;

        Save();
        ShowBar();
    }

    http_response(key id, integer code, list meta, string body)
    {
        if (id != gReq) return;
        if (gQuiet)
        {
            // Silent prefill on attach: only take languages, never chat.
            if (code != 200) return;
            string m = llJsonGetValue(body, ["my_lang"]);
            string s = llJsonGetValue(body, ["send_lang"]);
            integer changedLang = FALSE;
            if (gMy == "" && llListFindList(CODES, [m]) != -1 && m != gSend) { gMy = m; changedLang = TRUE; }
            if (gSend == "" && llListFindList(CODES, [s]) != -1 && s != gMy) { gSend = s; changedLang = TRUE; }
            if (changedLang) { Save(); ShowBar(); }
            return;
        }
        if (code != 200) { Note("license server unreachable (HTTP " + (string)code + "). Try again later."); return; }
        string st = llJsonGetValue(body, ["status"]);
        if (st == "not_found")
        {
            Note("no license linked to this avatar yet. Start Firestorm with SL Translator Pro and log in, then try again.");
            return;
        }
        string days = llJsonGetValue(body, ["days_left"]);
        string plan = llJsonGetValue(body, ["plan"]);
        string ver = llJsonGetValue(body, ["dll_version"]);
        string online = llJsonGetValue(body, ["dll_online"]);
        string msg;
        if (st == "active")
        {
            msg = "License ACTIVE";
            if (days != JSON_NULL && days != JSON_INVALID) msg += " - " + days + " day(s) left";
        }
        else if (st == "expired") msg = "License EXPIRED. Renew at sltranslate.com";
        else if (st == "disabled") msg = "License DISABLED. Contact support.";
        else msg = "License status: " + st;
        if (plan != JSON_INVALID && plan != "") msg += " | plan: " + plan;
        if (ver != JSON_INVALID && ver != "") msg += " | client v" + ver;
        if (online == JSON_TRUE) msg += " | viewer connected";
        else msg += " | viewer not connected";
        Note(msg);
    }
}
