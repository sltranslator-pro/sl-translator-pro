# Keep repository text normalization predictable.
*.cpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.nsi text eol=lf
*.ps1 text eol=lf
*.yml text eol=lf
*.bat text eol=crlf

# Preserve upstream MinHook formatting without treating its historical
# trailing spaces as project whitespace errors.
third_party/minhook/** whitespace=-blank-at-eol
